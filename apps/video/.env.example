# ──────────────────────────────────────────────────────────────────────
# Bazzy Video — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-openssl-rand-hex-32
SEED_DEMO=true                   # demo catalog on an empty DB; set false in production
ENVIRONMENT=development          # development | staging | production
CORS_ORIGINS=http://localhost:3000,https://bazzyvideo.com

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bazzy:changeme_in_prod@postgres:5432/bazzy_video
POSTGRES_PASSWORD=changeme_in_prod

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ── OCI Object Storage ───────────────────────────────────────────────
OCI_NAMESPACE=your-tenancy-namespace
OCI_BUCKET_HOT=bazzy-video-media-hot
OCI_BUCKET_COLD=bazzy-video-media-cold
OCI_REGION=us-ashburn-1
OCI_ACCESS_KEY=your-oci-s3-compat-access-key
OCI_SECRET_KEY=your-oci-s3-compat-secret-key

# ── Cloudflare ───────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cf-api-token
CLOUDFLARE_ACCOUNT_ID=your-cf-account-id
CLOUDFLARE_STREAM_TOKEN=your-cf-stream-token
# CDN base for HLS delivery
CDN_BASE_URL=https://bazzyvideo.com/hls

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api/v1        # browser calls go through the website; leave as is
NEXT_PUBLIC_STRIPE_PK=pk_test_...

# ── Kafka ────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

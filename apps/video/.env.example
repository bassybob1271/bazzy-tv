# ──────────────────────────────────────────────────────────────────────
# Bazzy Video — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-openssl-rand-hex-32
SEED_DEMO=true                   # demo catalog on an empty DB; set false in production
ENVIRONMENT=development          # development | staging | production
CORS_ORIGINS=http://localhost:3000,https://bazzyvideo.com

# ── Sign-in ──────────────────────────────────────────────────────────
# Public address of the website (Next.js; it proxies /api). Used for OAuth redirect URIs.
PUBLIC_URL=http://localhost:3000

# Sign in with Google: console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID (Web application). Authorized redirect URI:
#   {PUBLIC_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple: developer.apple.com → Identifiers → Services ID (enable Sign in with Apple,
# domain + Return URL {PUBLIC_URL}/api/v1/auth/oauth/apple/callback, https only), and
# Keys → a key with Sign in with Apple. Paste the .p8 contents with \n for line breaks.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Apps that can "Sign in with Bazzy TV" (JSON). Generate the secret with: openssl rand -hex 32
# The same secret goes in BazzyBox's BAZZY_CLIENT_SECRET.
OAUTH_CLIENTS=[{"client_id":"bazzybox","client_secret":"change-me","name":"BazzyBox","redirect_uris":["https://box.bazzy.tv/api/auth/bazzy/callback","https://box.bazzy.io/api/auth/bazzy/callback"],"trusted":true},{"client_id":"bazzylive","client_secret":"change-me-too","name":"Bazzy Live","redirect_uris":["https://live.bazzy.tv/auth/bazzy/callback","https://live.bazzy.io/auth/bazzy/callback"],"trusted":true}]

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bazzy:changeme_in_prod@postgres:5432/bazzy_video
POSTGRES_PASSWORD=changeme_in_prod

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ── Video storage: Backblaze B2 (bucket BazzyVideo, written lowercase for the S3 API) ─────────────────
STORAGE_BACKEND=b2
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com   # bucket page → "Endpoint", with https://
B2_BUCKET=bazzyvideo
B2_KEY_ID=                                           # application key limited to BazzyVideo
B2_APP_KEY=
B2_PUBLIC_URL=                                       # Bunny pull zone in front of the bucket (free B2→Bunny egress)
# Leave B2_PUBLIC_URL empty to serve video with signed, expiring B2 links (bucket stays private).
# Check the connection and set bucket CORS: docker compose exec api python -m app.b2_check

# ── OCI Object Storage (STORAGE_BACKEND=oci) ─────────────────────────
OCI_NAMESPACE=your-tenancy-namespace
OCI_BUCKET_HOT=bazzy-video-media-hot
OCI_BUCKET_COLD=bazzy-video-media-cold
OCI_REGION=us-ashburn-1
OCI_ACCESS_KEY=your-oci-s3-compat-access-key
OCI_SECRET_KEY=your-oci-s3-compat-secret-key

# ── Cloudflare ───────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cf-api-token
CLOUDFLARE_ACCOUNT_ID=your-cf-account-id
CLOUDFLARE_STREAM_TOKEN=your-cf-stream-token
# CDN base for HLS delivery
CDN_BASE_URL=https://bazzyvideo.com/hls

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api/v1        # browser calls go through the website; leave as is
NEXT_PUBLIC_STRIPE_PK=pk_test_...
# Sister sites linked in the header (build time; empty hides the link)
NEXT_PUBLIC_BAZZY_LIVE_URL=https://live.bazzy.tv
NEXT_PUBLIC_BAZZYBOX_URL=https://box.bazzy.tv

# ── Kafka ────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
